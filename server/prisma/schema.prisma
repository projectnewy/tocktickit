// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Declaration order is load-bearing: Postgres enums sort by declaration order,
// so `orderBy: { requestedPriority: "desc" }` returns the most urgent first.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Lab 3: real Ticket workflow states, replacing Lab 2's placeholder set.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// Lab 3: one role per user. See specification.md BR-23.
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Lab 4: Actions Taken lifecycle. Only PLANNED -> COMPLETED and PLANNED -> CANCELLED are
// allowed (specification.md BR-06); the rule lives in code, the enum keeps the column valid.
enum ActionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model RelatedSystem {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  tickets     Ticket[]
}

// Lab 2's RequesterUser, extended in place for real authentication and roles.
// @@map keeps the physical Postgres table name unchanged — this is an application-level
// rename only, no data migration risk.
model User {
  id                 Int      @id @default(autoincrement())
  fullName           String
  email              String   @unique // login identity
  passwordHash       String
  role               Role     @default(REQUESTER)
  mustChangePassword Boolean  @default(false)
  department         String?
  isActive           Boolean  @default(true) // inactive => cannot authenticate
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tickets             Ticket[]       @relation("TicketRequester")
  ownedTickets        Ticket[]       @relation("TicketOwner")
  uploadedAttachments Attachment[]   @relation("AttachmentUploader")
  removedAttachments  Attachment[]   @relation("AttachmentRemover")
  comments            Comment[]
  internalNotes       InternalNote[]
  createdActions      ActionTaken[]  @relation("ActionCreator")
  assignedActions     ActionTaken[]  @relation("ActionAssignee")
  performedActions    ActionTaken[]  @relation("ActionPerformer")

  @@map("RequesterUser")
}

model Ticket {
  id                  Int          @id @default(autoincrement())
  ticketNumber        String       @unique // TKT-2026-000042
  summary             String       @db.VarChar(150)
  description         String       @db.Text
  requestedPriority   Priority
  itPriority          Priority? // defaults to requestedPriority at creation; IT Staff/Admin may change it
  status              TicketStatus @default(NEW)
  resolutionIndicated Boolean      @default(false) // Requester's "Problem Appears Resolved" flag
  version             Int          @default(0) // Lab 4 optimistic concurrency (BR-19): +1 on every write
  resolvedAt          DateTime? // Lab 4: set on Resolved, kept through Closed, cleared on reopen (BR-18)

  requesterId     Int
  ownerId         Int? // primary Ticket Owner: active IT Staff or Administrator, nullable = unassigned
  categoryId      Int
  relatedSystemId Int

  createdAt DateTime @default(now()) // serialized to the client as `ticketDate`
  updatedAt DateTime @updatedAt

  requester     User           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner         User?          @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem RelatedSystem  @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments   Attachment[]
  comments      Comment[]
  internalNotes InternalNote[]
  actions       ActionTaken[]

  @@index([requesterId, createdAt(sort: Desc)])
  @@index([requesterId, status, createdAt(sort: Desc)])
  @@index([requesterId, categoryId])
  @@index([requesterId, relatedSystemId])
  @@index([ownerId, status])
  @@index([status, createdAt(sort: Desc)])
  // Lab 4 dashboard queries (specification.md §7).
  @@index([status, updatedAt(sort: Desc)])
  @@index([requesterId, updatedAt(sort: Desc)])
}

// Lab 4: planned or completed work recorded under a Ticket. Append-only: there is no delete,
// an action is cancelled instead (BR-11), so every relation to it is Restrict except the Ticket.
model ActionTaken {
  id               Int          @id @default(autoincrement())
  ticketId         Int
  createdById      Int // immutable (BR-09)
  assigneeId       Int // active IT Staff/Administrator at write time (BR-08)
  performedById    Int? // set to the completer; null until completed (BR-09)
  status           ActionStatus @default(PLANNED)
  actionDateTime   DateTime     @default(now())
  description      String       @db.VarChar(2000)
  result           String?      @db.VarChar(2000) // required when COMPLETED (BR-07)
  followUpRequired Boolean      @default(false)
  followUpNote     String?      @db.VarChar(1000) // required when followUpRequired (BR-07)
  attachmentNotes  String?      @db.VarChar(500) // free text, no file upload (spec §3)
  clientRequestId  String? // idempotent create (BR-21)
  version          Int          @default(0) // optimistic concurrency (BR-19)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy   User   @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee    User   @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  performedBy User?  @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)

  @@unique([ticketId, clientRequestId])
  @@index([ticketId, actionDateTime, id])
  @@index([assigneeId, status, actionDateTime])
}

model Attachment {
  id               Int      @id @default(autoincrement())
  ticketId         Int
  originalFilename String // display only, never touches the filesystem
  storedFilename   String   @unique // "<uuid>.<ext>"
  mimeType         String
  sizeBytes        Int
  uploadedById     Int
  uploadedAt       DateTime @default(now())

  removedAt     DateTime? // SOFT REMOVAL: null => active
  removedReason String?   @db.VarChar(200)
  removedById   Int?

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  removedBy  User?  @relation("AttachmentRemover", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt])
}

// Public Comments: visible to the owning Requester, IT Staff, and Administrator. Append-only.
model Comment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

// Internal Notes: visible only to IT Staff and Administrator. Append-only.
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

// Backs ticket-number generation — see server/src/services/ticketNumber.ts.
model TicketCounter {
  year       Int @id
  lastNumber Int @default(0)
}
